{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foxline",
  "version": "0.1.0",
  "identifier": "works.byteowlz.foxline",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8923",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Foxline",
        "width": 1080,
        "height": 800,
        "minWidth": 320,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https: wss:; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    },
    "iOS": {
      "minimumSystemVersion": "16.0",
      "infoPlist": "Info.ios.plist"
    }
  }
}